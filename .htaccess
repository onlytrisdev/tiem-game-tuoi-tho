DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .data .mem .bin
    AddType application/manifest+json .webmanifest
    AddType audio/ogg .ogg
    AddType image/webp .webp
    AddType font/ttf .ttf
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType text/plain .atlas .fnt
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "\.(wasm|data|webp|ico|ogg|ttf|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|webmanifest|js|png|jpg|jpeg)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
