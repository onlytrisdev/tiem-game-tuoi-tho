<ZBox width="100%" height="100%">
	<ZImage id="bg" src="bg2" left="0" right="0"/>
	<ZBox id="box" width="100%" height="100%">
		<ZLabel id="msg" text="游戏暂停中" width="100%" height="40" vAlign="center" size="24" color="0xffffff" hAlign="center" centerY="-100"/>
		<HBox centerY="-20" centerX="0">
			<ZButton id="back" src="GameMain:backhome"/>
			<ZButton id="resume" src="GameMain:goongame"/>
		</HBox>
		<HBox centerY="100" centerX="0">
			<ZButton id="1pkey" src="GameMain:1Pkey"/>
			<ZButton id="2pkey" src="GameMain:2Pkey"/>
		</HBox>
	</ZBox>
	<ZTween id="play" auto="true">
		<tween bind="bg" key="scaleY" start="0" end="10" from="0" to="1"/>
		<tween bind="bg" key="y" start="0" end="10" from="240" to="0"/>
		<tween bind="box" key="alpha" start="0" end="10" from="0" to="1"/>
	</ZTween>
	<ZTween id="hide" auto="false">
		<tween bind="bg" key="scaleY" start="0" end="10" from="1" to="0"/>
		<tween bind="bg" key="y" start="0" end="10" from="0" to="240"/>
		<tween bind="box" key="alpha" start="0" end="10" from="1" to="0"/>
	</ZTween>
</ZBox>